# ==========================================
# 🌐 System & Deployment Environment
# ==========================================

# NODE_ENV: ระบุโหมดการทำงานของโปรเจกต์ (development | production)
# โหมด development จะแสดง Error แบบละเอียด ส่วน production จะรีดประสิทธิภาพสูงสุด
NODE_ENV="development"

# NEXT_PUBLIC_APP_URL: โดเมนหลักของเว็บไซต์ (รวมถึง http/https)
# ใช้สำหรับสร้าง Dynamic Sitemap.xml, SEO JSON-LD Schema, และ Canonical URLs
# ตัวอย่าง Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NEXT_PUBLIC_BASE_URL: โดเมนหลัก (Legacy Support)
# หากโค้ดบางจุดยังเรียกใช้ BASE_URL ให้ตั้งค่าให้ตรงกับ APP_URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"


# ==========================================
# 📧 Email & Contact Form Service (Resend)
# ==========================================

# RESEND_API_KEY: กุญแจ API สำหรับบริการส่งอีเมลของ Resend.com
# ใช้ในหน้า /contact เมื่อผู้เยี่ยมชมกรอกแบบฟอร์มติดต่อ
# สมัครและรับ Key ฟรีได้ที่: https://resend.com
RESEND_API_KEY="re_123456789_xxxxxxxxxxxxxxxxxxxxxx"

# RECEIVER_EMAIL: อีเมลปลายทางที่คุณต้องการให้แบบฟอร์มส่งข้อมูลไปหา
# ตัวอย่าง: อีเมลส่วนตัวของคุณเอง
RECEIVER_EMAIL="your.email@example.com"


# ==========================================
# 🖼️ Media & External Services
# ==========================================

# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME: ชื่อ Cloud Name บน Cloudinary
# (เผื่อในอนาคตต้องการใช้ระบบฝากรูปภาพแยกจาก Vercel เพื่อลด Bandwidth)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_name"
